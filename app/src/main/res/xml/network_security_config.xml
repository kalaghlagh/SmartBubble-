<?xml version="1.0" encoding="utf-8"?>
<!-- All network traffic (AI provider requests carry API keys and user content) must use TLS.
     Only the system certificate store is trusted; user-installed certificates are not. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
