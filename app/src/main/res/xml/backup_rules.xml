<?xml version="1.0" encoding="utf-8"?>
<!--
   Auto Backup rules for Android 11 (API 30) and lower.
   Provider API keys are encrypted with an Android Keystore key, which is never backed up, so a
   restored ciphertext could not be decrypted. The credential file is therefore excluded; after a
   restore the user re-enters API keys in Settings. Everything else keeps the default behaviour.
-->
<full-backup-content>
    <exclude domain="sharedpref" path="smartbubble_credentials.xml" />
</full-backup-content>
