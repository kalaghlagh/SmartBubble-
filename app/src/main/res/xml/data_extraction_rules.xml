<?xml version="1.0" encoding="utf-8"?>
<!--
   Backup and device-transfer rules for Android 12 (API 31) and higher.
   Provider API keys (encrypted with a non-exportable Android Keystore key) are excluded from both
   cloud backup and device-to-device transfer; they would be unusable on restore.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="smartbubble_credentials.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="smartbubble_credentials.xml" />
    </device-transfer>
</data-extraction-rules>
